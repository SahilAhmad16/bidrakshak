# MongoDB Connection URI (e.g. MongoDB Atlas or local MongoDB)
# Example Atlas URI: mongodb+srv://<username>:<password>@cluster0.mongodb.net/bidrakshak?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/bidrakshak

# JWT Secret Key for authenticating sessions
JWT_SECRET=your-secure-random-jwt-secret-key-replace-in-production

# Next.js Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
